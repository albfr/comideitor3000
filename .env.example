# Copia este archivo a .env.local y completa los valores.

# Better Auth: secreto para firmar las sesiones (genera uno con `openssl rand -base64 32`)
# y la URL pública de la app (en Vercel, tu dominio con https).
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Credenciales OAuth de Google (Google Cloud Console → APIs y servicios → Credenciales).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Emails que pueden entrar, separados por comas. Sin valor, en desarrollo entra cualquiera y en producción nadie.
EMAILS_PERMITIDOS=

# Base de datos Turso. Sin TURSO_DATABASE_URL se usa el archivo local local.db.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Vercel Blob, solo para que npm run db:cargar suba las imágenes de data/catalogo.json.
BLOB_READ_WRITE_TOKEN=
